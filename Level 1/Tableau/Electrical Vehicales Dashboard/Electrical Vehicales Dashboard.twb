      <column caption='Total Vehicales' datatype='integer' name='[Calculation_1990720519073792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([DOL Vehicle ID])' />
      </column>
      <column caption='Avg Electric Range' datatype='real' name='[Calculation_1990720521113601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Electric Range])' />
      </column>
      <column caption='TotalBEV Vehicles' datatype='integer' name='[Calculation_2309579233906688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot;&#13;&#10;THEN [DOL Vehicle ID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='% of BEV Vehicles' datatype='real' name='[Calculation_2309579235024897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2309579233906688]/[Calculation_1990720519073792]' />
      </column>
      <column caption='% Of BEV Vehicles' datatype='real' name='[Calculation_2309579235672066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2309579233906688]/[Calculation_1990720519073792]' />
      </column>
      <column caption='Total PHEV Vehicles' datatype='integer' name='[Calculation_2309579239120899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#13;&#10;THEN [DOL Vehicle ID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='% of PHEV Vehicles' datatype='real' name='[Calculation_2309579239391236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2309579239120899] / [Calculation_1990720519073792]' />
      </column>
